// pi FUN FUN FUN (sets to 0)
        integral = 0;
        previousLeftCount = 0;
        previousRightCount = 0;
        previousTime = millis();

        // keep going till the left wheel reaches the counttotarget
        while (leftEncoderCount < counttotarget)
        {
            //makes a new long holding the current time 
            unsigned long currentTime = millis();

            // Updates the motor motor correction every 100 milliseconds
            if (currentTime - previousTime >= 100)
            {
                //holds the current left and right value = to the right and left encoder counts
                unsigned long currentLeft = leftEncoderCount;
                unsigned long currentRight = rightEncoderCount;

                // Calculate encoder changes from the previous count to the current
                long leftChange = (long)(currentLeft - previousLeftCount);
                long rightChange = (long)(currentRight - previousRightCount);

                // Calculate error from the change
                DriveError = leftChange - rightChange;

                // Calculate elapsed time in seconds
                double dt = (currentTime - previousTime) / 1000.0;

                // the integral tries to measure how much faster or slower a wheel has been from the other
                integral += DriveError * dt;

                // if the integral part keeps accumulating error for too long it will start to over correct these conditionals stop that
                if (integral > 40)
                {
                    integral = 40;
                }
                else if (integral < -40)
                {
                    integral = -40;
                }

                // Calculate TOTAL PI correction
                double correction = (Kp * DriveError) + (Ki * integral);

                // Adjust right motor duty cycle based on the correction calculated from the error kp & integral and KI
                rdutyStraight = Dcycle.toInt() + correction;

                // Failsafe duty cycle conditionals
                if (rdutyStraight > 80.0)
                {
                    rdutyStraight = 80.0;
                }
                else if (rdutyStraight < 20.0)
                {
                    rdutyStraight = 20.0;
                }

                // Update right motor 
                ledcWrite(rpwmChannel, rdutyStraight * maxDutyCycle / 100.0);

                // Update display
                UpdateDisplay(rdutyStraight, (int)currentLeft, (int)currentRight, DriveError);

                // Prints the screen info
                Serial.print("Left: ");
                Serial.print(currentLeft);

                Serial.print(" Right: ");
                Serial.print(currentRight);

                Serial.print(" Error: ");
                Serial.print(DriveError);

                Serial.print(" Integral: ");
                Serial.print(integral);

                Serial.print(" Right Duty: ");
                Serial.println(rdutyStraight);

                // Saves previous encoder counts and time for the next loop :)
                previousLeftCount = currentLeft;
                previousRightCount = currentRight;
                previousTime = currentTime;
            }
         
        }
            // stops once done
            ledcWrite(lpwmChannel, 0);
            ledcWrite(rpwmChannel, 0);
